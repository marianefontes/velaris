# Hostinger deploy credentials — copy to .env.deploy (gitignored).
# hPanel → Websites → beatrice.world → Files → FTP Accounts / SSH Access

# Required
HOSTINGER_HOST=XX.XX.XX.XX
HOSTINGER_USER=uYYYYYYYYY

# Remote document root (usually public_html for the primary domain)
HOSTINGER_REMOTE_PATH=domains/beatrice.world/public_html

# rsync over SSH (recommended — enable SSH in hPanel first)
HOSTINGER_DEPLOY_METHOD=rsync
HOSTINGER_SSH_PORT=XXXXX

# FTP fallback (only if SSH/rsync is unavailable)
# HOSTINGER_DEPLOY_METHOD=lftp
# HOSTINGER_FTP_PORT=21
# HOSTINGER_PASSWORD=your-ftp-password

# Post-deploy smoke check
HOSTINGER_SITE_URL=https://url.com
