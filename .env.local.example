# Optional frontend override for the Beatrice API endpoint.
# In local development, Vite already proxies /api to http://localhost:3333,
# so this file is only needed if you want to point the app to a different API.
VITE_ORACLE_API_URL=http://localhost:3333/api/chat

# Required for the Python backend (server.py / FastAPI):
# GROQ_API_KEY=gsk_...

# Free-tier laboratory defaults. The main chat continues using Llama 3.3 70B.
LABORATORY_GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
LABORATORY_REQUEST_INTERVAL_SECONDS=13
LABORATORY_RATE_LIMIT_RETRIES=6
