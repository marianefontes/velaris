{
  "name": "aetheris-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "python3 scripts/check_primary_navigation.py && tsc -b && vite build",
    "check:i18n": "node scripts/check_i18n.mjs",
    "check:i18n:strict": "node scripts/check_i18n.mjs --strict",
    "preview": "vite preview",
    "start": "uvicorn server:app --port 3333 --reload",
    "start:legacy": "node server.cjs",
    "index": "python3 rag/extract_docs.py && python3 rag/setup_vectordb.py --reset",
    "watch-rag": "python3 rag/watch.py",
    "test:rag": "python3 rag/test_e2e.py",
    "test:beatrice": "python3 scripts/test_beatrice_capabilities.py",
    "test:perspectives": "python3 scripts/test_perspective_contracts.py && vitest run src/beatrice/domain/perspective/perspectives.test.ts",
    "test:reasoning-ui": "python3 scripts/test_reasoning_capabilities_ui.py",
    "test:agent": "python3 -W error::ResourceWarning -m unittest discover -s tests/agent -p 'test_*.py' -v",
    "test:agent-smoke": "python3 -W error::ResourceWarning -m unittest tests.agent.test_sse.AgentSSEContractTests.test_primary_workflow_chat_smoke -v",
    "test:agent-contracts": "python3 scripts/test_agent_layer_contracts.py",
    "test:agent-ui": "vitest run",
    "test:agent-all": "npm run test:agent && npm run test:agent-contracts && npm run test:agent-ui",
    "test:intelligence": "python3 -m unittest tests.agent.test_knowledge_health -v && python3 scripts/test_intelligence_e2e.py",
    "test:reliability-gates": "python3 scripts/run_reliability_gates.py",
    "validate:agent-examples": "python3 scripts/validate_agent_layer_v1.py"
  },
  "dependencies": {
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.511.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4",
    "recharts": "^2.15.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
